{
  "name": "trader-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "dev": "tsx src/routines/index.ts",
    "backtest": "tsx scripts/run-backtest.ts"
  },
  "dependencies": {
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@/(.*)$": "<rootDir>/web/$1",
      "^@guards/(.*)$": "<rootDir>/src/guards/$1",
      "^@scheduler/decide$": "<rootDir>/src/scheduler/decide.ts",
      "^@scheduler/decide-crypto$": "<rootDir>/src/scheduler/decide-crypto.ts",
      "^@scheduler/routine-lock$": "<rootDir>/src/scheduler/routine-lock.ts",
      "^@scheduler/run-status$": "<rootDir>/src/scheduler/run-status.ts",
      "^@scheduler/(.*)$": "<rootDir>/src/scheduler/$1",
      "^@snapshots/baseline$": "<rootDir>/src/snapshots/baseline.ts",
      "^@snapshots/returns$": "<rootDir>/src/snapshots/returns.ts",
      "^@snapshots/(.*)$": "<rootDir>/src/snapshots/$1",
      "^@ai-cost/pricing$": "<rootDir>/src/ai-cost/pricing.ts",
      "^@ai-cost/(.*)$": "<rootDir>/src/ai-cost/$1",
      "^@ai/json-response$": "<rootDir>/src/ai/json-response.ts",
      "^@backtest/(.*)$": "<rootDir>/src/backtest/$1"
    },
    "roots": ["<rootDir>/src", "<rootDir>/web"],
    "testMatch": ["<rootDir>/{src,web}/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "target": "ES2022",
            "module": "ESNext",
            "moduleResolution": "bundler",
            "isolatedModules": true,
            "rootDir": ".",
            "paths": {
              "@/*": ["./web/*"],
              "@guards/*": ["./src/guards/*"]
            }
          }
        }
      ]
    }
  }
}
