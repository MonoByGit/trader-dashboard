# Database (Postgres)
DATABASE_URL=

# Alpaca paper trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Optional: iex (default) or sip
# ALPACA_DATA_FEED=iex

# AI provider: gemini (default) | claude | anthropic | deepseek
AGENT_PROVIDER=gemini

# Google Gemini (when AGENT_PROVIDER=gemini)
GOOGLE_AI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-flash

# Anthropic Claude (when AGENT_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-sonnet-4-6
CLAUDE_SMART_MODEL=claude-opus-4-5

# DeepSeek OpenAI-compatible API (when AGENT_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_SMART_MODEL=deepseek-flash

# Max output tokens for JSON agent calls (premarket, decisions, lessons); default 4096
AI_JSON_MAX_TOKENS=4096

# Cron: Bearer token for POST /api/cron (no app login cookie)
CRON_SECRET=

# App login (public URL): httpOnly session cookie (momentum_session, 30 days)
# Prefer APP_PASSWORD_SHA256 (lowercase hex SHA-256 of UTF-8 password); when set, APP_PASSWORD is ignored.
# APP_PASSWORD_SHA256=echo -n 'your-password' | sha256sum | awk '{print $1}'
APP_PASSWORD_SHA256=
APP_PASSWORD=
# Optional: HMAC key for session cookies (recommended in production). Else APP_PASSWORD_SHA256 or APP_PASSWORD.
SESSION_SECRET=

# Public app URL (cron self-calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

